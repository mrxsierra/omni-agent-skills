# ==============================================================================
# omni-agent-skills Environment Configuration Template
# Copy this file to .env and insert your real keys for local neural evaluation.
# Note: .env is gitignored to guarantee zero credential leakage.
# ==============================================================================

# 1. OpenRouter (Unified API: free models end with :free, e.g. cohere/north-mini-code:free)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# 2. Direct Cloud Provider API Keys (Optional)
# Gemini free tier default: gemini-2.5-flash
GEMINI_API_KEY=your_gemini_api_key_here
# Mistral free tier default: codestral-latest (or open-mistral-7b, ministral-8b-latest)
MISTRAL_API_KEY=your_mistral_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# 3. Custom OpenAI-Compatible Endpoints (Optional)
# OPENAI_BASE_URL=https://api.together.xyz/v1

# 4. Open-Weights / Local Engine Configuration
OLLAMA_HOST=http://localhost:11434

# 5. Google Antigravity CLI Binary Path (Optional, defaults to 'agy' on PATH)
# AGY_CLI_PATH=/usr/local/bin/agy
