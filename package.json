{
  "name": "omni-agent-skills",
  "version": "0.0.2",
  "description": "Tool-neutral AI agent skill registry and asset catalog",
  "main": "registry/registry.json",
  "scripts": {
    "build": "python3 scripts/build_registry.py",
    "validate": "python3 scripts/validate_registry.py",
    "sanitize": "python3 scripts/sanitize.py",
    "test": "python3 -m unittest discover -s tests -p 'test_*.py'",
    "version": "python3 scripts/bump.py",
    "adr:new": "python3 scripts/manage_adr.py new",
    "adr:build": "python3 scripts/manage_adr.py build-index",
    "adr:validate": "python3 scripts/manage_adr.py validate"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mrxsierra/omni-agent-skills.git"
  },
  "keywords": [
    "ai-agent",
    "antigravity",
    "claude-code",
    "cursor",
    "agentic-skills",
    "security-shield",
    "mcp",
    "llms-txt"
  ],
